# =================================================================
# SECRETS - `sdr setup` writes .env for you; this file only documents it.
# .env is git-ignored: never commit it or share it.
# Your targeting and email wording live in config/profile.toml instead.
# =================================================================

# 1. Email login used to send cold emails and read replies (`sdr setup --section email`).
#    Gmail / Google Workspace: SMTP_HOST=smtp.gmail.com      SMTP_PORT=465  IMAP_HOST=imap.gmail.com
#                              (needs an App Password: https://myaccount.google.com/apppasswords)
#    Outlook / Microsoft 365:  SMTP_HOST=smtp.office365.com  SMTP_PORT=587  IMAP_HOST=outlook.office365.com
#                              (only where Microsoft still allows password logins for SMTP/IMAP)
#    Hostinger:                SMTP_HOST=smtp.hostinger.com  SMTP_PORT=465  IMAP_HOST=imap.hostinger.com
#    Zoho Mail:                SMTP_HOST=smtp.zoho.com       SMTP_PORT=465  IMAP_HOST=imap.zoho.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@yourdomain.com
SMTP_PASS=your-app-password
IMAP_HOST=imap.gmail.com
IMAP_PORT=993

# 2. Dashboard password, stored only as a hash (`sdr setup --section security` or
#    `sdr dashboard --set-password` sets it).
#    Format: pbkdf2_sha256$<iterations>$<salt_b64>$<hash_b64>. Leave empty for no password
#    (the dashboard is still reachable from this computer only).
DASHBOARD_PASSWORD_HASH=

# 3. Optional but recommended: Brave Search API key for finding leads.
#    Free key: https://brave.com/search/api/  (`sdr setup --section audience` saves it here).
#    With [targeting] search_engine = "auto" (the default) lead search uses Brave when this is set
#    and DuckDuckGo when it's empty. Test it with `sdr doctor --online`.
BRAVE_API_KEY=

# 4. Optional: where hot-lead alerts + the daily digest go (default: SMTP_USER).
#    Can also be set as [sdr] alert_email in config/profile.toml.
SDR_ALERT_EMAIL=

# 5. Optional: Claude AI - personal opening lines + smarter reply triage.
#    Also set [ai] enabled = true in config/profile.toml and `pip install anthropic`
#    (inside the project's .venv).
ANTHROPIC_API_KEY=

# 6. Optional: get a ping when new leads / hot leads come in
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
